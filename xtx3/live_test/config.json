{
  "networks": [
    {
      "id": "xtx3-u",
      "label": "XTX3-u (0.82 M params, whole-frame)",
      "format": "ncnn",
      "param": "../runs/xtx3-u/export/xtx3_u_{size}.ncnn.param",
      "bin": "../runs/xtx3-u/export/xtx3_u_{size}.ncnn.bin",
      "sizes": [256, 320, 384],
      "default_size": 320,
      "mode": "whole",
      "strides": [8, 16, 32],
      "input_blob": "in0",
      "output_blobs": { "box": "out0", "cls": "out1", "kpt": "out2" },
      "skeleton_preset": "xtx3_9"
    }
  ],
  "skeleton_presets": {
    "xtx3_9": {
      "keypoints": [
        "nose", "left_eye", "right_eye", "left_ear", "right_ear",
        "left_shoulder", "right_shoulder", "left_hip", "right_hip"
      ],
      "edges": [[0, 1], [0, 2], [1, 3], [2, 4], [5, 6], [5, 7], [6, 8], [7, 8]],
      "sides": ["c", "l", "r", "l", "r", "l", "r", "l", "r"],
      "oks_sigmas": [0.026, 0.025, 0.025, 0.035, 0.035, 0.079, 0.079, 0.107, 0.107]
    }
  },
  "camera": {
    "width": 1280,
    "height": 720,
    "fps": 30,
    "mjpg": true,
    "max_probe_index": 8,
    "mirror": true,
    "windows_backend": "msmf"
  },
  "inference": {
    "conf_threshold": 0.25,
    "kpt_threshold": 0.3,
    "max_detections": 50,
    "num_threads": 4,
    "use_vulkan": false,
    "async_inference": false,
    "dedup": false,
    "merge": { "oks_match_thr": 0.5, "iou_match_thr": 0.5 }
  },
  "display": {
    "window_title": "XTX3 live test",
    "show_bbox": true,
    "show_labels": false,
    "show_hud": true,
    "point_radius": 4,
    "line_thickness": 2
  }
}
