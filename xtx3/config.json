{
  "training": {
    "epochs": 50,
    "checkpoint_interval_minutes": 5,
    "batch_size": 32,
    "optimizer": "musgd",
    "lr0": 0.01,
    "lr_final_factor": 0.01,
    "warmup_epochs": 3,
    "weight_decay": 0.0005,
    "momentum": 0.937,
    "amp": true,
    "ema_decay": 0.9999,
    "num_workers": 8,
    "seed": 0,
    "multi_scale": {
      "u": [256, 320, 384],
      "n": [],
      "m": [],
      "l": []
    }
  },
  "data": {
    "dataset_path": "./dataset",
    "network_size": 384,
    "view_mode": {
      "u": "whole",
      "n": "pyramid",
      "m": "pyramid",
      "l": "pyramid"
    },
    "view_ratio": {
      "1": 1,
      "2": 1,
      "3": 1
    },
    "min_visible_keypoints": 1,
    "close_mosaic_epochs": 10,
    "augment": {
      "fliplr": 0.5,
      "hsv_h": 0.015,
      "hsv_s": 0.7,
      "hsv_v": 0.4,
      "scale_jitter": 0.5,
      "translate": 0.1,
      "mosaic": 0.5
    }
  },
  "model": {
    "num_keypoints": 9,
    "use_p2": {
      "u": false,
      "n": false,
      "m": false,
      "l": true
    }
  },
  "inference": {
    "u": { "mode": "whole", "size": 320 },
    "n": { "mode": "pyramid", "size": 384 },
    "m": { "mode": "pyramid", "size": 384 },
    "l": { "mode": "pyramid", "size": 384 }
  },
  "loss": {
    "box": 7.5,
    "cls": 0.5,
    "kpt": 12.0,
    "vis": 1.0,
    "center_prior_weight": 0.1,
    "keypoint_loss": "rle",
    "stal_min_anchors": 4,
    "stal_size_px": 8,
    "progloss": {
      "o2m_start": 1.0,
      "o2m_end": 0.25,
      "o2o_start": 0.5,
      "o2o_end": 1.0
    }
  },
  "merge": {
    "mode": "threshold",
    "oks_match_thr": 0.5,
    "iou_match_thr": 0.5,
    "conf_threshold": 0.25,
    "max_detections": 300,
    "logistic_weights": []
  },
  "validation": {
    "max_images": 200
  },
  "export": {
    "auto_export": true,
    "onnx_opset": 17,
    "converter": "pnnx",
    "sizes": {
      "u": [256, 320, 384],
      "n": [384],
      "m": [384],
      "l": [384]
    }
  }
}
